  "rules": [
    {
      "boundary": "A0 locks (no `lockfileVersion`) are refused by vendored mode",
      "suite": "vendored",
      "legs": "*",
      "except": [
        "absent_version_refused"
      ],
      "versions": {
        "op": "<=",
        "a": "0.0.0-18"
      },
      "conditions": [],
      "reason": "a0-vendored-unsupported"
    },
    {
      "boundary": "A0 locks are refused by vendored mode",
      "suite": "migration",
      "legs": "*",
      "except": [],
      "versions": {
        "op": "<=",
        "a": "0.0.0-18"
      },
      "conditions": [],
      "reason": "a0-vendored-unsupported"
    },
    {
      "boundary": "A0 locks are refused by vendored mode",
      "suite": "production",
      "legs": [
        "vendored_install_proof"
      ],
      "except": [],
      "versions": {
        "op": "<=",
        "a": "0.0.0-18"
      },
      "conditions": [],
      "reason": "a0-vendored-unsupported"
    },
    {
      "boundary": "the global store and `store-linker`",
      "suite": "safety",
      "legs": "*",
      "except": [],
      "versions": {
        "op": "<",
        "a": "1.2.0"
      },
      "conditions": [],
      "reason": "no-global-store"
    },
    {
      "boundary": "`vlt ci`, `--frozen-lockfile`, `--expect-lockfile` exist",
      "suite": "hosted",
      "legs": [
        "frozen_dead_registry",
        "optional_dependency_heal",
        "then_vendored_optional_takeover"
      ],
      "except": [],
      "versions": {
        "op": "<",
        "a": "0.0.0-19"
      },
      "conditions": [],
      "reason": "no-vlt-ci"
    },
    {
      "boundary": "a scalar `registry` makes lock-driven installs re-resolve from public npm",
      "suite": "hosted",
      "legs": [
        "frozen_dead_registry"
      ],
      "except": [],
      "versions": {
        "op": "range",
        "a": "1.0.0-rc.7",
        "b": "1.0.0-rc.29"
      },
      "conditions": [],
      "reason": "non-hermetic-registry"
    },
    {
      "boundary": "registry tarball integrity is not enforced on a cold fetch",
      "suite": "hosted",
      "legs": [
        "tamper_cold_eintegrity"
      ],
      "except": [],
      "versions": {
        "op": "==",
        "a": "0.0.0-1"
      },
      "conditions": [],
      "reason": "integrity-unenforced"
    },
    {
      "boundary": "bare specs honor `registries.npm`",
      "suite": "hosted",
      "legs": [
        "mirror_registries_npm"
      ],
      "except": [],
      "versions": {
        "op": "<",
        "a": "1.0.0-rc.33"
      },
      "conditions": [],
      "reason": "registries-npm-ignored"
    },
    {
      "boundary": "named registry specs (`acme:x@1`), scoped registries and URL-segment DepIDs exist (flat-config releases record every registry node under the default segment)",
      "suite": "hosted",
      "legs": [
        "named_alias_untouched"
      ],
      "except": [],
      "versions": {
        "op": "<",
        "a": "0.0.0-14"
