load("@io_bazel_rules_go//go:def.bzl", "go_binary")
load("//:probe.bzl", "socket_probe")

# gazelle:prefix example.com/consumer
# Tier 0: the sources of the module go_repository fetched. Tier 1 compiles the
# library: a source file of another repository is not visible on Bazel 9.
socket_probe(
    name = "socket_probe",
    srcs = ["@com_github_pmezard_go_difflib//difflib"],
)

# Tier 2: prints OUT: SEED 3 from the upstream module.
go_binary(
    name = "consumer",
    srcs = ["main.go"],
    deps = ["@com_github_pmezard_go_difflib//difflib"],
)
