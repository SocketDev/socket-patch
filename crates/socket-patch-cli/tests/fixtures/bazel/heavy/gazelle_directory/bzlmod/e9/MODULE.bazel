module(name = "socket_fixture", version = "0.0.0")

bazel_dep(name = "rules_go", version = "0.65.0")
bazel_dep(name = "gazelle", version = "0.54.0")
single_version_override(module_name = "rules_go", version = "0.65.0")
single_version_override(module_name = "gazelle", version = "0.54.0")

# rules_go 0.65.0 rejects an older SDK: its own go.mod says go 1.26.0.
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.0")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.config(check_direct_dependencies = "error")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "com_example_upstream", "com_example_local")
