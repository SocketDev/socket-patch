load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("//:probe.bzl", "socket_probe")

# Tier 0: the sources of the crate the hub fetched. Tier 1 compiles the
# library: a source file of another repository is not visible on Bazel 9.
socket_probe(
    name = "socket_probe",
    srcs = ["@crates//:itoa-1.0.15"],
)

# Tier 2: prints ITOA=1015 ITOA04=48. Two versions of one crate name: the hub
# has no plain `itoa` alias, so every consumer names a versioned one.
rust_binary(
    name = "consumer",
    srcs = ["src/main.rs"],
    aliases = {"@crates//:itoa-0.4.8": "itoa04"},
    edition = "2021",
    deps = [
        "@crates//:itoa-0.4.8",
        "@crates//:itoa-1.0.15",
    ],
)
