module(name = "socket_fixture", version = "0.0.0")

# pip fetches here, not Bazel's downloader: the index is the test's own, and
# the harness writes its address over the placeholder in the workspace copy.
bazel_dep(name = "rules_python", version = "1.3.0")
single_version_override(module_name = "rules_python", version = "1.3.0")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.11",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pypi",
    python_version = "3.11",
    extra_pip_args = [
        "--index-url",
        "http://socket-fixture.invalid/pip-mode/simple",
    ],
    requirements_lock = "//:requirements.txt",
)
use_repo(pip, "pypi")
