load("@rules_python//python:defs.bzl", "py_binary")
load("@rules_python//python:pip.bzl", "compile_pip_requirements")
load("//:probe.bzl", "socket_probe")

exports_files(["requirements.txt"])

# Tier 0 and 1: the wheel Bazel fetched for the hub.
socket_probe(
    name = "socket_probe",
    srcs = ["@pypi//spvictim:whl"],
)

# Tier 2: prints SPVICTIM=vulnerable until the package is patched.
py_binary(
    name = "consumer",
    srcs = ["consumer.py"],
    deps = ["@pypi//spvictim"],
)

# The lock check a hosted rewrite turns red: `//:requirements.test` compares
# the file with a fresh pip-compile of requirements.in. pip-compile resolves
# with pip, not with Bazel's downloader, and this release takes the index
# from extra_args alone (it runs pip without a config file): the harness
# writes the fixture server's address over the placeholder in the workspace
# copy. --no-emit-index-url keeps that address out of requirements.txt.
compile_pip_requirements(
    name = "requirements",
    src = "requirements.in",
    extra_args = [
        "--index-url=http://socket-fixture.invalid/pip-mode/simple",
        "--no-emit-index-url",
    ],
    requirements_txt = "requirements.txt",
)
