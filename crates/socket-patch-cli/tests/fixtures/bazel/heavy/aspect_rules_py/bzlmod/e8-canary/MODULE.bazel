module(name = "socket_fixture", version = "0.0.0")

bazel_dep(name = "aspect_rules_py", version = "1.8.4")
single_version_override(module_name = "aspect_rules_py", version = "1.8.4")
bazel_dep(name = "rules_python", version = "1.0.0")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.12",
)

uv = use_extension("@aspect_rules_py//uv/unstable:extension.bzl", "uv")
uv.declare_hub(hub_name = "pypi")
uv.declare_venv(
    hub_name = "pypi",
    venv_name = "default",
)
uv.lockfile(
    hub_name = "pypi",
    src = "//:uv.lock",
    venv_name = "default",
)
use_repo(uv, "pypi")
