module(name = "socket_fixture", version = "0.0.0")

bazel_dep(name = "rules_pycross", version = "2.0.1")
single_version_override(module_name = "rules_pycross", version = "2.0.1")
bazel_dep(name = "rules_python", version = "2.0.0")
single_version_override(module_name = "rules_python", version = "2.0.0")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.12",
)
use_repo(python, "python_versions")

pycross = use_extension("@rules_pycross//pycross/extensions:pycross.bzl", "pycross")
pycross.configure_toolchains(
    platforms = [
        "aarch64-apple-darwin",
        "x86_64-unknown-linux-gnu",
    ],
    python_versions = ["3.12"],
)

uv = use_extension("@rules_pycross//pycross/extensions:uv.bzl", "uv")
uv.workspace(
    name = "pypi",
    lock_file = "//:uv.lock",
)
uv.repo(
    dependency_groups = ["default"],
    workspace = "pypi",
)
use_repo(uv, "pypi")
