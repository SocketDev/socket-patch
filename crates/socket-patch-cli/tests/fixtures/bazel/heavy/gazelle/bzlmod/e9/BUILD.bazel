load("@rules_go//go:def.bzl", "go_binary")
load("//:probe.bzl", "socket_probe")

# Tier 0: the sources of the module go_deps fetched. Tier 1 compiles the
# library: a source file of another repository is not visible on Bazel 9.
socket_probe(
    name = "socket_probe",
    srcs = ["@com_example_upstream//:upstream"],
)

# Tier 2: prints OUT: PRISTINE until the module is patched.
go_binary(
    name = "consumer",
    srcs = ["main.go"],
    deps = ["@com_example_upstream//:upstream"],
)
