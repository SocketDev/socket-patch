# The toy core fixture, Bzlmod: no external ruleset, one hub read from a JSON lock.

module(name = "toy_core")

toy = use_extension("//:toy.bzl", "toy")
toy.lock(file = "//:toy.lock.json")
use_repo(toy, "toy")

# The facts-bearing variant (Bazel 8.6 and later): this extension records no
# input in MODULE.bazel.lock, only one fact per package the toy registry serves.
toy_facts = use_extension("//:toy.bzl", "toy_facts")
toy_facts.lock(file = "//facts:toy.lock.json")
use_repo(toy_facts, toy_facts = "toy")
