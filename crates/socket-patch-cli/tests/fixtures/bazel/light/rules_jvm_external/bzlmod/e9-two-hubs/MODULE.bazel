module(name = "socket_fixture_rules_jvm_external")

bazel_dep(name = "rules_jvm_external", version = "7.2")
bazel_dep(name = "rules_java", version = "9.3.0")

# The ruleset under test stays at the version this fixture is written for.
single_version_override(
    module_name = "rules_jvm_external",
    version = "7.2",
)

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    artifacts = [
        "org.slf4j:slf4j-simple:1.7.36",
        "com.google.code.gson:gson:2.10.1",
    ],
    fail_if_repin_required = True,
    lock_file = "//:maven_install.json",
    repositories = ["https://repo1.maven.org/maven2"],
)
maven.install(
    name = "other",
    artifacts = [
        "org.slf4j:slf4j-simple:1.7.36",
        "com.google.code.gson:gson:2.10.1",
    ],
    fail_if_repin_required = True,
    lock_file = "//:other_install.json",
    repositories = ["https://repo1.maven.org/maven2"],
)

# Only the hubs are imported. The artifact repository of slf4j-api is named after
# the version (`org_slf4j_slf4j_api_1_7_36`), so a rewrite of the lock to another
# version renames it: a `use_repo` of it would then name a repository the
# extension no longer generates. `e9-spoke` keeps that shape.
use_repo(maven, "maven", "other")
