load("@rules_java//java:defs.bzl", "java_binary")
load("//:probe.bzl", "socket_probe")

# Tier 0: the versionless hub label, the one name of the artifact that a rewrite
# of the lock leaves alone. A query over it lists the registry jar under the
# artifact repository's `file/` directory and fetches no other artifact and no
# JDK. Building this target analyses a `jvm_import`, and with it a Java
# toolchain, so the proof for this fixture stops at the query.
socket_probe(
    name = "socket_probe",
    srcs = ["@maven//:org_slf4j_slf4j_api"],
)

# Tier 2: a program that loads a class from slf4j-api and prints whether
# the jar it came from carries the patch marker.
java_binary(
    name = "consumer",
    srcs = ["src/App.java"],
    main_class = "App",
    runtime_deps = ["@maven//:org_slf4j_slf4j_simple"],
    deps = [
        "@maven//:com_google_code_gson_gson",
        "@maven//:org_slf4j_slf4j_api",
    ],
)
