module(name = "socket_fixture_rules_jvm_external")

bazel_dep(name = "rules_jvm_external", version = "7.2")
bazel_dep(name = "rules_java", version = "9.3.0")

# The ruleset under test stays at the version this fixture is written for.
single_version_override(
    module_name = "rules_jvm_external",
    version = "7.2",
)

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")

# An unpinned hub: no `lock_file`, so Coursier resolves on every cold fetch
# and Bazel holds no checksum for what it downloads. Coursier opens its own
# connections, which no downloader config reaches, so the repository itself
# is a loopback URL on a fixed port; a test that builds this workspace
# serves the Maven mirror there or writes its own port into its copy.
maven.install(
    name = "unpinned",
    artifacts = ["org.slf4j:slf4j-api:1.7.36"],
    repositories = ["http://127.0.0.1:18731/maven2"],
)
use_repo(maven, "unpinned")
