module(name = "socket_fixture", version = "0.0.0")

bazel_dep(name = "rules_csharp", version = "0.5.0")
single_version_override(module_name = "rules_csharp", version = "0.5.0")

# The hub reads the lock `dotnet restore` writes, and the package sources
# from nuget.config.
nuget = use_extension("@rules_csharp//csharp:extensions.bzl", "nuget")
nuget.from_lock(
    nuget_config = "//:nuget.config",
    packages_lock_json = "//:packages.lock.json",
)
use_repo(nuget, "nuget")
