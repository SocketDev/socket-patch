module(name = "x3_probe")

bazel_dep(name = "rules_go", version = "0.65.0")
bazel_dep(name = "gazelle", version = "2.0.0-beta.2")

single_version_override(module_name = "rules_go", version = "0.65.0")
single_version_override(module_name = "gazelle", version = "2.0.0-beta.2")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.0")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "com_github_google_go_cmp", "com_github_jackc_pgx_v5")

bazel_dep(name = "othermod", version = "0.0.0")
local_path_override(module_name = "othermod", path = "../othermod")
