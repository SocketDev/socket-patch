1: include "//shared:llvm.MODULE.bazel" dev=false
3: call bazel_dep(name="rules_cc", version="0.2.18")
4: call bazel_dep(name="rules_python", version="2.0.0")
5: call bazel_dep(name="rules_foreign_cc", version="0.15.1")
7: include "//shared:overrides.MODULE.bazel" dev=false
9: call bazel_dep(name="rules_pycross", version="0.0.0")
10: call bazel_dep(name="bazel_lib", version="3.2.0")
12: call local_path_override(module_name="rules_pycross", path="../../..")
# Third party deps
18: include "//third_party/openssl:repositories.MODULE.bazel" dev=false
19: include "//third_party/postgresql:repositories.MODULE.bazel" dev=false
20: include "//third_party/zlib:repositories.MODULE.bazel" dev=false
22: bind python = use_extension("@rules_python//python/extensions:python.bzl", "python")
23: tag python.toolchain(is_default=True, python_version="3.14.2")
27: call use_repo($python, "python_versions")
29: bind pycross = use_extension("@rules_pycross//pycross/extensions:pycross.bzl", "pycross")
30: tag pycross.configure_toolchains(platforms=["aarch64-apple-darwin", "aarch64-unknown-linux-gnu", "x86_64-unknown-linux-gnu", "x86_64-unknown-linux-musl"], python_versions=["3.14.2"])
42: bind uv = use_extension("@rules_pycross//pycross/extensions:uv.bzl", "uv")
43: tag uv.workspace(name="uv", lock_file="//:uv.lock")
47: tag uv.repo(dependency_groups=["default", "transitive"], workspace="uv")
54: tag uv.package(name="psycopg2", build_target="@//deps/psycopg2:wheel", workspace="uv")
59: tag uv.package(name="setproctitle", build_mode="always", workspace="uv")
64: tag uv.package(name="pyyaml", build_mode="always", workspace="uv")
70: bind setuptools = use_extension("@rules_pycross//pycross/backends:setuptools.bzl", "setuptools")
# Wildcard: default copts for all setuptools-built packages.
# Tests wildcard+specific merging:
#   - pyyaml inherits these copts alongside its specific build_env and tool_deps
#   - zstandard's specific copts replace these
# (psycopg2 uses a custom build_target, so backend overrides don't apply to it.)
77: tag setuptools.override(name="*", copts=["-O2"], workspace="uv")
82: tag setuptools.override(name="zstandard", copts=["-O2", "-Wl,-s"], workspace="uv")
90: tag setuptools.override(name="pyyaml", build_env={"PYYAML_FORCE_LIBYAML": "0"}, tool_deps={"wheel": "@uv//wheel:pkg"}, workspace="uv")
101: call use_repo($uv, "uv")
103: bind zstd = use_extension("//:zstd.bzl", "zstd")
104: call use_repo($zstd, "zstd")
