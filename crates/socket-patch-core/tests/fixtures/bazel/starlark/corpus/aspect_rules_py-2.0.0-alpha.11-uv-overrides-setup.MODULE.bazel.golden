5: tag uv.project(hub_name="pypi_all_lock_overrides", lock="//uv-all-lock-overrides/alpha:uv.lock", pyproject="//uv-all-lock-overrides/alpha:pyproject.toml")
10: tag uv.project(hub_name="pypi_all_lock_overrides", lock="//uv-all-lock-overrides/beta:uv.lock", pyproject="//uv-all-lock-overrides/beta:pyproject.toml")
15: tag uv.project(hub_name="pypi_all_lock_overrides", lock="//uv-all-lock-overrides/gamma:uv.lock", pyproject="//uv-all-lock-overrides/gamma:pyproject.toml")
20: tag uv.project(hub_name="pypi_all_lock_overrides", lock="//uv-all-lock-overrides/delta:uv.lock", pyproject="//uv-all-lock-overrides/delta:pyproject.toml")
25: tag uv.override_package(name="boltons", post_install_patches=["//uv-all-lock-overrides:post_install.patch"], version="25.0.0")
