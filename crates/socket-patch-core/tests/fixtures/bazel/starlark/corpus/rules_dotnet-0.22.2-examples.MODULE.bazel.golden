1: docstring
3: call module(name="rules_dotnet_examples", version="0.0.0", compatibility_level=1)
# Only needed to make the Bazel CI RBE config work. Not needed for using rules_dotnet.
10: call bazel_dep(name="bazel_ci_rules", version="1.0.0", dev_dependency=True)
11: call bazel_dep(name="platforms", version="0.0.10", dev_dependency=True)
13: bind internal_dev_deps = use_extension("//:internal_dev_deps.bzl", "internal_dev_deps", dev_dependency=True)
14: call use_repo($internal_dev_deps, "buildkite_config")
16: call bazel_dep(name="rules_dotnet", version="0.0.0")
17: call local_path_override(module_name="rules_dotnet", path="..")
22: bind dotnet = use_extension("@rules_dotnet//dotnet:extensions.bzl", "dotnet")
23: tag dotnet.toolchain(dotnet_version="10.0.201")
24: call use_repo($dotnet, "dotnet_toolchains")
26: call register_toolchains("@dotnet_toolchains//:all")
28: bind example_deps_extension = use_extension("//:paket.example_deps_extension.bzl", "example_deps_extension")
29: call use_repo($example_deps_extension, "paket.example_deps")
31: bind main_extension = use_extension("//paket/deps:paket.main_extension.bzl", "main_extension")
32: call use_repo($main_extension, "paket.main")
34: bind othergroup_extension = use_extension("//paket/deps:paket.othergroup_extension.bzl", "othergroup_extension")
35: call use_repo($othergroup_extension, "paket.othergroup")
