1: call workspace(name="rules_dotnet_examples")
5: load "@bazel_tools//tools/build_defs/repo:http.bzl" http_archive
7: call local_repository(name="rules_dotnet", path="..")
12: load "@rules_dotnet//dotnet:repositories.bzl" dotnet_register_toolchains rules_dotnet_dependencies
18: call rules_dotnet_dependencies()
20: call dotnet_register_toolchains("dotnet", "7.0.101")
22: load "@rules_dotnet//dotnet:paket.rules_dotnet_nuget_packages.bzl" rules_dotnet_nuget_packages
24: call rules_dotnet_nuget_packages()
26: load "@rules_dotnet//dotnet:paket.paket2bazel_dependencies.bzl" paket2bazel_dependencies
28: call paket2bazel_dependencies()
30: load "//:paket.example_deps.bzl" example_deps
32: call example_deps()
34: load "//paket/deps:paket.main.bzl" main
36: call main()
38: load "//paket/deps:paket.othergroup.bzl" othergroup
40: call othergroup()
# Used for Bazel CI
43: call http_archive(name="bazelci_rules", sha256="eca21884e6f66a88c358e580fd67a6b148d30ab57b1680f62a96c00f9bc6a07e", strip_prefix="bazelci_rules-1.0.0", url="https://github.com/bazelbuild/continuous-integration/releases/download/rules-1.0.0/bazelci_rules-1.0.0.tar.gz")
50: load "@bazelci_rules//:rbe_repo.bzl" rbe_preconfig
# Creates a default toolchain config for RBE.
# Use this as is if you are using the rbe_ubuntu16_04 container,
# otherwise refer to RBE docs.
55: call rbe_preconfig(name="buildkite_config", toolchain="ubuntu1804-bazel-java11")
