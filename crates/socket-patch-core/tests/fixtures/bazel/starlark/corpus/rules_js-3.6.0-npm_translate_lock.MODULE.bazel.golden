1: call bazel_dep(name="aspect_rules_js", version="0.0.0", dev_dependency=True)
2: call local_path_override(module_name="aspect_rules_js", path="../..")
7: call bazel_dep(name="bazel_skylib", version="1.5.0", dev_dependency=True)
9: bind pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
10: tag pnpm.pnpm(name="pnpm", pnpm_version="9.15.9")
14: call use_repo($pnpm, "pnpm", "pnpm__links")
16: bind npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm", dev_dependency=True)
21: tag npm.npm_translate_lock(name="npm", data=["//:package.json"], npmrc="//:.npmrc", pnpm_lock="//:pnpm-lock.yaml", update_pnpm_lock=True, verify_node_modules_ignored="//:.bazelignore")
29: call use_repo($npm, "npm")
