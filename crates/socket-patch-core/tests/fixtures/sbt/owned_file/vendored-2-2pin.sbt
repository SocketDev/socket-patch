  resolvers += {
    val repo = new java.io.File(baseDirectory.value, ".socket/vendor/maven2").getCanonicalFile
    socketPatchVendorPins.foreach { case (_, _, _, rel, want, src) =>
      val f = new java.io.File(repo, rel)
