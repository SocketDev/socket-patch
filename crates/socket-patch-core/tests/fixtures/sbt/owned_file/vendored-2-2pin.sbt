    val mine = pins.filter(x => x._1 == m.module.organization && x._2 == m.module.name)
    mine.headOption.foreach { case (g, a, sv, _, _, _) =>
      if (m.module.revision != sv) socketPatchVendorFail(p + " resolves " + g + ":" + a + ":" + m.module.revision + ", expected " + sv + "; a dependencyOverrides := or resolver change in the build replaced socket-patch's")
      m.artifacts.foreach { case (_, f) =>
        val got = socketPatchVendorSha256(f)
