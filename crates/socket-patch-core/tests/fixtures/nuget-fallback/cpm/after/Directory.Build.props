<Project>
  <!-- socket-patch:begin created (generated; remove with: socket-patch vendor revert) -->
  <PropertyGroup Label="socket-patch">
    <CustomAfterDirectoryBuildTargets Condition="!$(CustomAfterDirectoryBuildTargets.Contains('socket-patch.targets'))">$(CustomAfterDirectoryBuildTargets);$(MSBuildThisFileDirectory).socket/vendor/nuget/socket-patch.targets</CustomAfterDirectoryBuildTargets>
  </PropertyGroup>
  <Target Name="SocketPatchNuGetImportCheck" BeforeTargets="_GenerateRestoreGraph;CollectPackageReferences" Condition="'$(SocketPatchNuGetTargetsImported)' != 'true' and '$(SocketPatchNuGetGuard)' != 'false'">
    <Error Code="SOCKETPATCH007" Text="socket-patch: .socket/vendor/nuget/socket-patch.targets was not imported, so the vendored NuGet patches of this repo are missing from this checkout. Check out .socket/vendor/nuget (git sparse-checkout add .socket/vendor/nuget) or run 'socket-patch vendor'." />
  </Target>
  <!-- socket-patch:end -->
</Project>
