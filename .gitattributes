# The redirect golden fixtures are a byte-exact cross-language contract
# (consumed by both this crate's redirect_golden.rs and the depscan backend's
# golden.test.ts). EOL conversion on checkout (Windows CRLF) breaks the
# byte-for-byte comparison, so they are checked out exactly as committed.
crates/socket-patch-core/tests/fixtures/redirect/** -text

crates/socket-patch-core/tests/fixtures/pdm-native/*.lock -text

# The captured pnpm 1-12 locks are byte-real: the hosted/vendored rewriters
# refuse CRLF by design (vendor_lockfile_crlf_unsupported), and the tests
# derive their CRLF variants from the LF bytes themselves.
crates/socket-patch-core/tests/fixtures/pnpm-hosted/** -text

# Captured vlt locks are byte-real; CRLF variants are derived in the tests.
crates/socket-patch-core/tests/fixtures/vlt-locks/** -text
