<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven Central distribution of the socket-patch CLI: a dependency-free
  launcher jar that downloads the prebuilt binary for the host platform from
  the matching GitHub release on first run, verifies it against the release's
  SHA256SUMS, caches it per-user, and runs it (same pattern as the RubyGems
  and Composer launchers — see gem/socket-patch and composer/socket-patch).

  Published by the maven-central-publish job in .github/workflows/release.yml
  via the Central Publisher Portal (central.sonatype.com). Central requires
  GPG .asc signatures on every file plus real -sources and -javadoc jars, all
  produced by the plugins below. Build without signing:
    mvn package -Dgpg.skip=true
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.socket</groupId>
  <artifactId>socket-patch</artifactId>
  <!-- Kept in sync by scripts/version-sync.sh (anchored on the marker comment). -->
  <version>3.3.0</version><!-- x-version-sync -->
  <packaging>jar</packaging>

  <name>socket-patch</name>
  <description>CLI tool for applying security patches to dependencies. Launcher that downloads the prebuilt socket-patch binary for the host platform.</description>
  <url>https://github.com/SocketDev/socket-patch</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>Socket Security</name>
      <organization>Socket</organization>
      <organizationUrl>https://socket.dev</organizationUrl>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/SocketDev/socket-patch.git</connection>
    <developerConnection>scm:git:git@github.com:SocketDev/socket-patch.git</developerConnection>
    <url>https://github.com/SocketDev/socket-patch</url>
  </scm>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- JDK 11 floor: java.net.http.HttpClient's Redirect.NORMAL implements
         the HTTPS-only redirect policy the launcher requires (see
         Launcher.java); the jar runs on any JRE 11+. -->
    <maven.compiler.release>11</maven.compiler.release>
    <!-- Reproducible builds (also required for Central's checksum sanity).
         Bumped by hand when it matters; the value only needs to be fixed. -->
    <project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.0</version>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>dev.socket.socketpatch.Launcher</mainClass>
              <!-- Stamps Implementation-Version with ${project.version}; the
                   launcher reads it to pick the release to download, so the
                   binary always matches the artifact the user resolved. -->
              <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
            </manifest>
          </archive>
        </configuration>
      </plugin>

      <!-- Central requires -sources and -javadoc jars for jar packaging. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals>
              <goal>jar-no-fork</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.11.2</version>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <goals>
              <goal>jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Central requires a GPG .asc signature on every uploaded file. The
           passphrase comes from the MAVEN_GPG_PASSPHRASE env var (native to
           maven-gpg-plugin 3.2+); CI lint skips with -Dgpg.skip=true. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-gpg-plugin</artifactId>
        <version>3.2.7</version>
        <executions>
          <execution>
            <id>sign-artifacts</id>
            <phase>verify</phase>
            <goals>
              <goal>sign</goal>
            </goals>
            <configuration>
              <gpgArguments>
                <arg>--pinentry-mode</arg>
                <arg>loopback</arg>
              </gpgArguments>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Assembles + uploads the Central Portal bundle (checksums included).
           Credentials come from the `central` server entry, which
           actions/setup-java wires to CENTRAL_USERNAME/CENTRAL_PASSWORD. -->
      <plugin>
        <groupId>org.sonatype.central</groupId>
        <artifactId>central-publishing-maven-plugin</artifactId>
        <version>0.11.0</version>
        <extensions>true</extensions>
        <configuration>
          <publishingServerId>central</publishingServerId>
          <autoPublish>true</autoPublish>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
